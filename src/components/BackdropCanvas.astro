---
/**
 * 全站动态背景：一块 fixed 的 canvas，画在内容下面（z-index 0，不吃鼠标事件）。
 * 视觉语言参考 ae-ai-motion：AE 时间轴 / 关键帧 —— 正弦位移的网格、
 * 横向滑动的彩色色块（带菱形关键帧）、缓慢旋转的螺旋曲线。
 *
 * 要点：
 * - 颜色分两套：线条走 CSS 变量（深色模式自动跟上），色块走固定彩色盘（亮/暗底上都成立）。
 * - 尊重 prefers-reduced-motion：只画一帧静态画面，不排下一帧。
 * - 页面切到后台停 rAF；dpr 上限 2；手机端自动减少轨道数、缩小间距。
 * - 鼠标移动时：网格横向偏移、轨道整体上下浮动、螺旋中心轻微位移。
 */
---

<canvas class="backdrop" aria-hidden="true" data-speed="1"></canvas>

<script>
  const canvas = document.querySelector('.backdrop');
  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (ctx) initBackdrop(canvas, ctx);
  }

  function initBackdrop(canvas, ctx) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let width = 0;
    let height = 0;
    let dpr = 1;
    let rafId = 0;
    let running = false;
    let start = 0;

    // 指针用 0~1 表示，鼠标没动过时默认停在中间偏上
    const pointer = { x: 0.5, y: 0.35, tx: 0.5, ty: 0.35, active: false };

    // 线条颜色跟着主题走，色块用固定彩色盘
    let ink = [27, 27, 25];
    const palette = ['#ff775f', '#87e6c0', '#92cfff', '#f2d95c', '#c8a8e8'];
    const blocks = palette.concat(['#1b1b19']);

    function readColors() {
      const style = getComputedStyle(document.documentElement);
      ink = parseColor(style.getPropertyValue('--ink'), ink);
    }

    function parseColor(value, fallback) {
      const raw = (value || '').trim();
      const hex = raw.match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
      if (hex) {
        let h = hex[1];
        if (h.length === 3) h = h[0] + h[0] + h[1] + h[1] + h[2] + h[2];
        return [
          parseInt(h.slice(0, 2), 16),
          parseInt(h.slice(2, 4), 16),
          parseInt(h.slice(4, 6), 16),
        ];
      }
      const rgb = raw.match(/rgba?\(([^)]+)\)/);
      if (rgb) {
        const parts = rgb[1].split(/[,\s/]+/).filter(Boolean).map(Number);
        if (parts.length >= 3 && parts.every((n) => !Number.isNaN(n))) {
          return [parts[0], parts[1], parts[2]];
        }
      }
      return fallback;
    }

    const inkA = (a) => `rgba(${ink[0]}, ${ink[1]}, ${ink[2]}, ${a})`;

    // ---- 尺寸 ----
    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // ---- 每帧 ----
    function frame(time) {
      if (!start) start = time;
      const tick = ((time - start) / 1000) * 0.9; // 整体节奏，0.9 比参考站慢一点，更像背景

      pointer.x += (pointer.tx - pointer.x) * 0.05;
      pointer.y += (pointer.ty - pointer.y) * 0.05;

      ctx.clearRect(0, 0, width, height);

      drawGrid(tick);
      drawTracks(tick);
      drawSpiral(tick);

      if (!reduceMotion.matches) rafId = requestAnimationFrame(frame);
    }

    // 1. 网格：竖线被正弦推着左右摇，鼠标再给一点整体偏移
    function drawGrid(tick) {
      const gap = width < 680 ? 58 : 82;
      const drift = Math.sin(tick) * 10;
      const shift = (pointer.x - 0.5) * 26;
      ctx.strokeStyle = inkA(0.08);
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let x = -gap; x < width + gap; x += gap) {
        ctx.moveTo(x + drift + shift, 0);
        ctx.lineTo(x - 34 + shift, height);
      }
      ctx.stroke();
    }

    // 2. 时间轴轨道：横向滑动的彩色色块 + 菱形关键帧
    function drawTracks(tick) {
      const rows = Math.max(5, Math.min(9, Math.round(height / 96)));
      const spacing = width < 680 ? 50 : 58;
      const baseY = height * 0.16 + pointer.y * 30;
      const span = width + 240;

      for (let i = 0; i < rows; i += 1) {
        const y = baseY + i * spacing;
        // 偶数行往左滑、奇数行往右滑，画面不至于一边倒
        const dir = i % 2 === 0 ? 1 : -1;
        const travel = ((tick * 46 + i * 120) % span) * dir;
        const x = (dir === 1 ? travel - 180 : width + 60 - travel);

        // 轨道基线
        ctx.strokeStyle = inkA(i % 2 ? 0.1 : 0.16);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();

        // 色块
        const barW = 108 + i * 8;
        const barH = width < 680 ? 12 : 15;
        ctx.save();
        ctx.globalAlpha = i === 0 ? 0.62 : 0.46;
        ctx.fillStyle = blocks[i % blocks.length];
        ctx.fillRect(x, y - barH / 2, barW, barH);
        ctx.restore();

        // 关键帧菱形
        drawDiamond(x + barW + 34, y, width < 680 ? 9 : 11, blocks[(i + 1) % blocks.length], tick + i);
      }
    }

    function drawDiamond(cx, cy, size, color, phase) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(Math.PI / 4 + Math.sin(phase * 0.6) * 0.25);
      ctx.globalAlpha = 0.5;
      ctx.fillStyle = color;
      ctx.fillRect(-size / 2, -size / 2, size, size);
      ctx.restore();
    }

    // 3. 螺旋：像时间轴上的一条波形，慢速旋转
    function drawSpiral(tick) {
      const centerX = width * (0.72 + (pointer.x - 0.5) * 0.06);
      const centerY = height * 0.48 + (pointer.y - 0.5) * 20;
      const steps = 90;
      const scale = Math.min(1, width / 900);

      ctx.strokeStyle = inkA(0.34);
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      for (let i = 0; i < steps; i += 1) {
        const angle = i * 0.22 + tick * 0.7;
        const radius = (34 + i * 2.3) * (0.7 + scale * 0.3);
        const x = centerX + Math.cos(angle) * radius;
        const y = centerY + Math.sin(angle * 0.74) * radius * 0.36;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }

    function startLoop() {
      if (running) return;
      running = true;
      start = 0;
      rafId = requestAnimationFrame(frame);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
    }

    // ---- 事件 ----
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reduceMotion.matches) frame(0);
      }, 150);
    });

    window.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType === 'touch') return;
        pointer.tx = event.clientX / Math.max(window.innerWidth, 1);
        pointer.ty = event.clientY / Math.max(window.innerHeight, 1);
        pointer.active = true;
      },
      { passive: true }
    );

    document.addEventListener('pointerleave', () => {
      pointer.tx = 0.5;
      pointer.ty = 0.35;
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (!reduceMotion.matches) startLoop();
    });

    const darkQuery = window.matchMedia('(prefers-color-scheme: dark)');
    if (typeof darkQuery.addEventListener === 'function') {
      darkQuery.addEventListener('change', () => {
        readColors();
        if (reduceMotion.matches) frame(0);
      });
    }

    if (typeof reduceMotion.addEventListener === 'function') {
      reduceMotion.addEventListener('change', () => {
        stop();
        if (reduceMotion.matches) frame(0);
        else startLoop();
      });
    }

    // ---- 启动 ----
    readColors();
    resize();
    if (reduceMotion.matches) frame(0);
    else startLoop();
  }
</script>

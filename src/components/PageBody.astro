---
/**
 * 首页正文。只在 index.astro 里用，外面套一层 BaseLayout。
 * 当前是极简版：只有 Hero（名字 + 简介行）。
 * 想加回完整板块结构，看 git 历史里 commit 41ac065 之前的这个文件。
 */
import { type Profile } from '../data/profile';

interface Props {
  t: Profile;
}

const { t } = Astro.props;

const leadLines = t.hero.lead.split('\n').filter((l) => l.trim() !== '');
---

<main class="site">
  <section class="hero">
    <p class="hero__label">{t.hero.label}</p>
    <h1 class="hero__name">{t.hero.name}</h1>
    {leadLines.map((line) => <p class="hero__lead">{line}</p>)}
  </section>
</main>

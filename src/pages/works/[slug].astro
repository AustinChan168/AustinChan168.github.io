---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkDetail from '../../components/WorkDetail.astro';
import { getProfile } from '../../data/profile';
import { works, getWork } from '../../data/works';

export const getStaticPaths = (() =>
  works.map((work) => ({ params: { slug: work.slug }, props: { slug: work.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.props;
const t = getProfile('zh');
const work = getWork(slug);
if (!work) throw new Error(`找不到作品：${slug}`);
---

<BaseLayout t={t} pageTitle={work.text.zh.title} pageDescription={work.text.zh.summary} path={`/works/${slug}/`}>
  <WorkDetail locale="zh" work={work} />
</BaseLayout>

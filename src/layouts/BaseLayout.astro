---
/**
 * 全站外壳：html/head/顶栏/页脚 + 搜索引擎相关的 meta 标签。
 * 首页和博客页都套这一层，保证头部导航和语言切换一致。
 */
import '../styles/global.css';
import BackdropCanvas from '../components/BackdropCanvas.astro';
import { type Profile } from '../data/profile';
import { absoluteUrl, counterpartPath } from '../lib/posts';

interface Props {
  t: Profile;
  pageTitle?: string;
  pageDescription?: string;
  // 分享封面图。不传则用 public/og-default.png
  pageImage?: string;
  // 本页在站点内的路径，以 / 开头且以 / 结尾，例如 '/writing/first-post/'
  // 用于生成 canonical 和中英互跳的 hreflang；不传则视为首页
  path?: string;
}

const { t, pageTitle, pageDescription, pageImage, path = '/' } = Astro.props;

const BASE = import.meta.env.BASE_URL;

const title = pageTitle ? `${pageTitle} · ${t.hero.name}` : t.title;
const description = pageDescription ?? t.description;

// canonical 与语言互跳地址都由 path 推导，各页面不用重复写
const isEnglish = path.startsWith('/en/') || path === '/en/';
const canonical = absoluteUrl(path);
// 语言互跳：当前页在另一种语言里的地址（站内相对写法，用于顶部开关）
const zhPath = isEnglish ? counterpartPath(path) : path;
const enPath = isEnglish ? path : counterpartPath(path);
const hrefFor = (p: string) => BASE + p.replace(/^\//, '');
const zhUrl = isEnglish ? absoluteUrl(counterpartPath(path)) : canonical;
const enUrl = isEnglish ? canonical : absoluteUrl(counterpartPath(path));

// 社交平台分享卡片用的封面。放绝对路径，微信/Twitter 抓图时才认。
const ogImage = absoluteUrl(pageImage ?? '/og-default.png');
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={BASE + 'favicon.svg'} type="image/svg+xml" />

    <!-- 搜索引擎用：声明本页的正版 URL，避免中英两版互相抢排名 -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />

    <meta property="og:type" content={pageTitle ? 'article' : 'profile'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={t.hero.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'zh_CN'} />
    <meta property="og:locale:alternate" content={isEnglish ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // 在首屏渲染前把主题写好，避免深色模式闪一下白
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {
          /* 隐私模式下 localStorage 可能不可用，忽略即可 */
        }
      })();
    </script>

    <!-- 结构化数据：告诉搜索引擎「这是一个人 + 一个站」，搜索结果有机会显示更丰富的卡片 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': `${absoluteUrl('/')}#person`,
            name: t.hero.name,
            url: canonical,
            description,
            sameAs: t.sameAs,
          },
          {
            '@type': 'WebSite',
            '@id': `${absoluteUrl('/')}#website`,
            url: absoluteUrl('/'),
            name: t.hero.name,
            description,
            inLanguage: isEnglish ? 'en' : 'zh-CN',
            publisher: { '@id': `${absoluteUrl('/')}#person` },
          },
        ],
      })}
    />

    <slot name="extra-head" />
  </head>
  <body>
    <BackdropCanvas />

    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-header__name" href={BASE}>{t.hero.name}</a>
        <span class="site-header__spacer"></span>
        <nav class="site-nav" aria-label="navigation">
          {
            t.nav.pages.map((p) => (
              <a href={BASE + p.href.replace(/^\//, '')}>{p.label}</a>
            ))
          }
        </nav>

        <button class="theme-toggle" type="button" aria-label={t.ui.themeLabel} title={t.ui.themeLabel}>
          <span class="theme-toggle__glyph" aria-hidden="true">◐</span>
        </button>

        <div class="lang-switch" role="group" aria-label={t.ui.langSwitchLabel}>
          <a
            class:list={['lang-switch__item', { 'is-active': !isEnglish }]}
            href={hrefFor(zhPath)}
            hreflang="zh-CN"
            lang="zh-CN"
            aria-current={!isEnglish ? 'true' : undefined}>中文</a
          >
          <a
            class:list={['lang-switch__item', { 'is-active': isEnglish }]}
            href={hrefFor(enPath)}
            hreflang="en"
            lang="en"
            aria-current={isEnglish ? 'true' : undefined}>EN</a
          >
        </div>
      </div>
    </header>

    <slot />

    <script>
      // 主题切换：手动选择存 localStorage，没选过时由 CSS 跟随系统
      const root = document.documentElement;
      const button = document.querySelector('.theme-toggle');

      if (button) {
        button.addEventListener('click', () => {
          const saved = root.getAttribute('data-theme');
          const isDark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          const next = isDark ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* 存不进去也不影响本次切换 */
          }
        });
      }
    </script>

    <div class="site">
      <footer class="site-footer">
        <span>{t.ui.lastUpdated}</span>
        {t.ui.footerNote && <span class="site-footer__note">{t.ui.footerNote}</span>}
      </footer>
    </div>
  </body>
</html>
